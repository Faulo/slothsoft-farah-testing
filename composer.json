{
    "name": "slothsoft/farah-testing",
    "description": "Constraints and test suite stubs for Farah modules.",
    "license": "MIT",
    "authors": [
        {
            "name": "Daniel Schulz",
            "email": "info.slothsoft@gmail.com"
        }
    ],
    "type": "library",
    "require": {
        "php": ">=8.2",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-sockets": "*",
        "slothsoft/core": "^1.14.19",
        "slothsoft/farah": "^1.28.2",
        "symfony/browser-kit": "^7.4.8",
        "symfony/panther": "^2.2.0",
        "dbrekelmans/bdi": "^1.4.1",
        "symfony/dom-crawler": "^7.4.8",
        "php-webdriver/webdriver": "^1.16.0",
        "phpunit/phpunit": "~9.6.31"
    },
    "autoload": {
        "psr-4": {
            "Slothsoft\\FarahTesting\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Slothsoft\\FarahTesting\\": "tests/"
        }
    },
    "keywords": [
        "testing"
    ],
    "extra": {
        "branch-alias": {
            "dev-main": "1.3.x-dev"
        }
    },
    "homepage": "http://farah.slothsoft.net/modules/farah-testing"
}